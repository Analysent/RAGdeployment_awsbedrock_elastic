# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to version control.

# ── AWS ────────────────────────────────────────────────────
aws_region  = "us-east-1"
environment = "dev"

# ── Elastic Cloud ──────────────────────────────────────────
# Found in Elastic Cloud Console → Deployment → Deployment ID
deployment_id = "abc123def456"

# Full HTTPS endpoint shown in Elastic Cloud Console
elasticsearch_endpoint = "https://abc123def456.us-east-1.aws.elastic-cloud.com:9243"

# Name of the AWS Secrets Manager secret you created (keys: username, password)
elasticsearch_connection_secret = "elastic/deployment/credentials"

# PrivateLink service name — find in Elastic Cloud Console → Deployment → Security → Traffic filters
# Format: com.amazonaws.vpce.<region>.<vpce-svc-id>
elastic_private_link_service_name = "com.amazonaws.vpce.us-east-1.vpce-svc-0e42e1e06ed010238"

# DNS zone for PrivateLink — typically <region>.aws.elastic-cloud.com
elastic_private_link_zone_name = "us-east-1.aws.elastic-cloud.com"

# ── Networking (optional — defaults are fine for most deployments) ──
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24"]

# ── Bedrock models (defaults use Amazon Titan) ──────────────
bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"
bedrock_llm_model_id       = "amazon.titan-text-express-v1"

# ── Lambda tuning ───────────────────────────────────────────
lambda_memory_size       = 1024
lambda_timeout           = 300
vectorizer_chunk_size    = 1000
vectorizer_chunk_overlap = 200
