# ── Terraform ──────────────────────────────────────────────
# Local Terraform directories and state
.terraform/
.terraform.lock.hcl

# State files may contain resource IDs, ARNs, and secret values in plaintext
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/

# Crash log
crash.log
crash.*.log

# All .tfvars files may contain sensitive values — keep them local only
*.tfvars
*.tfvars.json
# Allow only the sanitised placeholder example
!terraform.tfvars.example

# Override files (may contain local overrides with real values)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Docker build artefacts ──────────────────────────────────
*.tar
*.tar.gz

# ── AWS credentials (never commit these) ───────────────────
.aws/
credentials
aws_credentials
*.pem
*.key

# ── Environment files ───────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE / editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets scanning output ──────────────────────────────────
.gitleaks.toml.local
